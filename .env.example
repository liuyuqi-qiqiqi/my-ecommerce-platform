# ============================================================
# Environment Variables — E-Commerce Platform
# ============================================================
# 1. Copy this file to .env
#      cp .env.example .env
# 2. Fill in your production values (especially passwords & secrets)
# 3. Generate a strong JWT secret:
#      openssl rand -base64 32
# ============================================================

# ---- Image tag (for versioned releases) ----
TAG=latest

# ---- Ports (host-side mapping) ----
FRONTEND_PORT=80
GATEWAY_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
ES_PORT=9200
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
ZIPKIN_PORT=9411

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password
MYSQL_USER=ecommerce
MYSQL_PASSWORD=change-me-to-a-strong-app-password

# ---- RabbitMQ ----
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# ---- JWT Secret ----
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-at-least-256-bits-secret-key!!

# ---- External infrastructure (optional; defaults use Compose service names) ----
# MYSQL_HOST=mysql
# REDIS_HOST=redis
# RABBITMQ_HOST=rabbitmq
# ES_URIS=http://elasticsearch:9200
# For cloud RDS/Redis, set host to your endpoint (e.g. host.docker.internal on Docker Desktop)

# ---- Scaling (Docker Compose, not Swarm) ----
# Use: docker compose up -d --scale product-service=2
# Services with fixed container_name (gateway, frontend, mysql, etc.) cannot be scaled.
